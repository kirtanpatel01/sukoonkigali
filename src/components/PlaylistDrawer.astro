---
import { SONGS } from '../data/songs';
---
<aside 
  id="playlist-drawer" 
  class="fixed inset-y-0 right-0 w-full max-w-[340px] bg-[#090b10]/80 border-l border-white/10 text-stone-200 z-40 opacity-0 translate-x-5 pointer-events-none transition-all duration-300 ease-in-out flex flex-col shadow-2xl select-none"
  aria-label="Playlist Drawer"
>
  <!-- Drawer Header -->
  <div class="px-6 py-5 border-b border-white/10 flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <h2 class="font-serif text-xl sm:text-2xl text-[#f5f0e1] font-light tracking-wide">Songs</h2>
      <button 
        id="drawer-btn-shuffle" 
        title="Shuffle List"
        aria-label="Toggle Shuffle List"
        class="text-stone-400/80 hover:text-[#e2b170] transition-colors cursor-pointer p-1"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/>
        </svg>
      </button>
      <button 
        id="drawer-feedback-btn" 
        title="Suggest a song"
        aria-label="Suggest a song"
        class="text-stone-400/80 hover:text-[#e2b170] transition-colors cursor-pointer p-1 text-xs flex items-center space-x-1 border-l border-white/10 pl-2 ml-1"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
        </svg>
        <span class="font-sans text-[11px] tracking-wider hidden sm:inline">Suggest</span>
      </button>
      <a 
        href="https://youtube.com/playlist?list=PLUKBMAqy5FT0&si=AXqRjl8h_BcCJjnq" 
        target="_blank" 
        rel="noopener noreferrer"
        title="Open Playlist on YouTube"
        aria-label="Open Playlist on YouTube"
        class="text-stone-400/80 hover:text-red-400 transition-colors cursor-pointer p-1 text-xs flex items-center space-x-1 border-l border-white/10 pl-2 ml-1"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        <span class="font-sans text-[11px] tracking-wider hidden sm:inline">YouTube</span>
      </a>
    </div>
    <div class="relative group">
      <button 
        id="close-drawer-btn" 
        aria-label="Close Playlist"
        class="text-stone-400 hover:text-[#f5f0e1] transition-colors p-1 cursor-pointer text-lg leading-none focus:outline-none"
      >
        ✕
      </button>
      <div class="pointer-events-none absolute -bottom-9 right-0 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-all duration-200 z-30 hidden md:flex items-center space-x-1.5 px-2 py-0.5 rounded-lg bg-[#090b10]/95 backdrop-blur-md border border-white/15 text-[11px] font-sans text-stone-200 shadow-xl whitespace-nowrap">
        <span>Close</span>
        <kbd class="px-1.5 py-0.5 rounded text-[10px] bg-white/10 border border-white/20 font-mono text-[#e2b170] uppercase">Esc</kbd>
      </div>
    </div>
  </div>

  <!-- Songs List: Printed / Handwritten aesthetic with tight, restrained spacing -->
  <div id="drawer-songs-list" class="flex-1 overflow-y-auto custom-scrollbar px-6 py-5 space-y-3.5 font-sans">
    {SONGS.map((song, index) => (
      <button 
        data-index={index} 
        class="drawer-song-item w-full text-left transition-all flex items-start space-x-3.5 cursor-pointer group py-0.5 border-b border-transparent"
      >
        <span class="drawer-song-num font-sans text-xs text-stone-500 group-hover:text-[#e2b170] pt-0.5 font-mono min-w-[20px]">
          {(index + 1).toString().padStart(2, '0')}
        </span>
        <div class="flex-1 min-w-0">
          <p class="drawer-song-title font-serif text-[#f5f0e1] group-hover:text-[#e2b170] truncate font-light text-base leading-snug">
            {song.title}
          </p>
          <p class="drawer-song-artist font-sans text-xs text-stone-400/80 truncate mt-0.5">
            {song.artist}
          </p>
        </div>
      </button>
    ))}
  </div>

  <!-- Drawer Footer: Minimal Divider + Counter + PWA Install -->
  <div class="px-6 py-3 border-t border-white/10 flex flex-col space-y-2 font-sans text-xs text-stone-400/80 tracking-wider">
    <div class="flex items-center justify-between w-full">
      <span id="drawer-counter-text">1 of {SONGS.length}</span>
      <button
        id="pwa-install-btn"
        class="hidden px-2.5 py-1 rounded bg-[#e2b170]/15 hover:bg-[#e2b170]/30 text-[#e2b170] border border-[#e2b170]/30 transition-all cursor-pointer items-center space-x-1.5"
        title="Install App"
      >
        <svg class="w-3.5 h-3.5 inline-block" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        <span>Install App</span>
      </button>
    </div>

    <!-- Creator Info -->
    <div class="pt-2 border-t border-white/5 flex items-center justify-between text-[11px] text-stone-500 font-normal tracking-normal">
      <span class="text-stone-400/80">Kirtan Patel</span>
      <div class="flex items-center space-x-2.5">
        <a 
          href="https://github.com/kirtanpatel01/sukoonkigali" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-[#e2b170] transition-colors"
          aria-label="GitHub Repository"
        >GitHub</a>
        <span class="text-stone-700">•</span>
        <a 
          href="https://instagram.com/kjpatel.dev" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-[#e2b170] transition-colors"
          aria-label="Instagram Profile"
        >@kjpatel.dev</a>
      </div>
    </div>
  </div>
</aside>

<!-- Overlay Backdrop: Dims and blurs background photo behind drawer -->
<div 
  id="drawer-backdrop" 
  class="fixed inset-0 bg-black/35 backdrop-blur-xs z-30 opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out"
></div>

<script is:inline>
  (function() {
    function setupDrawer() {
      const drawer = document.getElementById('playlist-drawer');
      const backdrop = document.getElementById('drawer-backdrop');
      const installBtn = document.getElementById('pwa-install-btn');

      if (installBtn) {
        if (window.deferredPWAInstallPrompt) {
          installBtn.classList.remove('hidden');
          installBtn.classList.add('flex');
        }
        installBtn.addEventListener('click', async function() {
          if (window.deferredPWAInstallPrompt) {
            window.deferredPWAInstallPrompt.prompt();
            const choice = await window.deferredPWAInstallPrompt.userChoice;
            if (choice && choice.outcome === 'accepted') {
              installBtn.classList.add('hidden');
              installBtn.classList.remove('flex');
            }
            window.deferredPWAInstallPrompt = null;
          }
        });
      }

      function openDrawer() {
        if (drawer) {
          drawer.classList.remove('opacity-0', 'translate-x-5', 'pointer-events-none');
          drawer.classList.add('opacity-100', 'translate-x-0', 'pointer-events-auto');
        }
        if (backdrop) {
          backdrop.classList.remove('opacity-0', 'pointer-events-none');
          backdrop.classList.add('opacity-100', 'pointer-events-auto');
        }
        if (installBtn && window.deferredPWAInstallPrompt) {
          installBtn.classList.remove('hidden');
          installBtn.classList.add('flex');
        }
      }

      function closeDrawer() {
        if (drawer) {
          drawer.classList.remove('opacity-100', 'translate-x-0', 'pointer-events-auto');
          drawer.classList.add('opacity-0', 'translate-x-5', 'pointer-events-none');
        }
        if (backdrop) {
          backdrop.classList.remove('opacity-100', 'pointer-events-auto');
          backdrop.classList.add('opacity-0', 'pointer-events-none');
        }
      }

      document.addEventListener('click', function(e) {
        const playlistBtn = e.target.closest('#btn-playlist');
        if (playlistBtn) {
          e.preventDefault();
          openDrawer();
          return;
        }
        if (e.target.closest('#close-drawer-btn') || e.target === backdrop) {
          closeDrawer();
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeDrawer();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupDrawer);
    } else {
      setupDrawer();
    }
  })();
</script>
