---
import { SONGS } from '../data/songs';
---
<aside 
  id="playlist-drawer" 
  class="fixed inset-y-0 right-0 w-full max-w-[385px] sm:max-w-[420px] bg-[#090b10]/95 backdrop-blur-2xl border-l border-white/10 text-stone-200 z-40 opacity-0 translate-x-8 pointer-events-none transition-all duration-400 ease-out flex flex-col shadow-2xl"
  aria-label="Playlist Drawer"
>
  <!-- Drawer Header -->
  <div class="px-6 py-4 border-b border-white/10 flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <h2 class="font-serif text-xl sm:text-2xl text-[#f5f0e1] font-light tracking-wide">Songs</h2>
      <button 
        type="button"
        id="drawer-btn-shuffle" 
        title="Shuffle List"
        aria-label="Toggle Shuffle List"
        class="text-stone-400/80 hover:text-[#e2b170] transition-colors cursor-pointer p-1"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/>
        </svg>
      </button>
    </div>
    <div class="relative group">
      <button 
        type="button"
        id="close-drawer-btn" 
        aria-label="Close Playlist"
        class="text-stone-400 hover:text-[#f5f0e1] transition-colors p-1.5 cursor-pointer text-lg leading-none focus:outline-none"
      >
        ✕
      </button>
      <div class="pointer-events-none absolute -bottom-9 right-0 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-all duration-200 z-30 hidden md:flex items-center space-x-1.5 px-2 py-0.5 rounded-lg bg-[#090b10]/95 backdrop-blur-md border border-white/15 text-[11px] font-sans text-stone-200 shadow-xl whitespace-nowrap">
        <span>Close</span>
        <kbd class="px-1.5 py-0.5 rounded text-[10px] bg-white/10 border border-white/20 font-mono text-[#e2b170] uppercase">Esc</kbd>
      </div>
    </div>
  </div>


  <!-- Search Input inside Drawer -->
  <div class="px-6 py-3 border-b border-white/10 bg-white/[0.02]">
    <div class="relative flex items-center">
      <svg class="w-4 h-4 text-stone-400 absolute left-3.5 pointer-events-none" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
      </svg>
      <input 
        type="text" 
        id="drawer-search-input" 
        placeholder={`Search ${SONGS.length} songs or artists...`} 
        class="w-full bg-white/5 border border-white/10 rounded-xl pl-10 pr-8 py-2 text-xs sm:text-sm text-[#f5f0e1] placeholder-stone-500/80 focus:outline-none focus:ring-1 focus:ring-[#e2b170]/70 focus:border-[#e2b170]/80 transition-all font-sans" 
      />
      <button 
        type="button"
        id="drawer-search-clear" 
        class="hidden absolute right-3 text-stone-400 hover:text-stone-200 text-xs p-1 cursor-pointer" 
        aria-label="Clear search"
      >
        ✕
      </button>
    </div>
  </div>

  <!-- Songs List: Smooth Touch Scrollable Container -->
  <div 
    id="drawer-songs-list" 
    class="flex-1 overflow-y-auto custom-scrollbar px-4 py-3 space-y-1 font-sans touch-pan-y"
    style="-webkit-overflow-scrolling: touch; touch-action: pan-y;"
  >
    {SONGS.map((song, index) => (
      <div 
        data-index={index} 
        data-queue-pos={index}
        data-youtube-id={song.youtubeId}
        data-title={song.title.toLowerCase()}
        data-artist={song.artist.toLowerCase()}
        class="drawer-song-item w-full text-left transition-all duration-200 flex items-center justify-between px-3 py-2 rounded-xl border border-transparent hover:bg-white/[0.04] group cursor-pointer"
      >
        <div class="flex items-center space-x-3 flex-1 min-w-0 drawer-song-click-area">
          <span class="drawer-song-num font-sans text-xs text-stone-500 group-hover:text-[#e2b170] font-mono w-7 flex-shrink-0 flex items-center justify-start">
            {(index + 1).toString().padStart(2, '0')}
          </span>
          <div class="flex-1 min-w-0 pr-1">
            <p class="drawer-song-title font-serif text-[#f5f0e1] group-hover:text-[#e2b170] truncate font-light text-base leading-snug">
              {song.title}
            </p>
            <p class="drawer-song-artist font-sans text-xs text-stone-400/80 truncate mt-0.5">
              {song.artist}
            </p>
          </div>
        </div>
        <label 
          class="exclude-checkbox-label relative flex items-center justify-center p-1.5 cursor-pointer group/checkbox select-none flex-shrink-0" 
          title="Exclude song"
        >
          <input 
            type="checkbox" 
            class="exclude-song-checkbox sr-only" 
            data-youtube-id={song.youtubeId} 
          />
          <div class="checkbox-box w-4 h-4 rounded border border-stone-500/60 group-hover/checkbox:border-[#e2b170] transition-colors flex items-center justify-center bg-black/20">
            <svg class="checkbox-check w-3 h-3 text-[#e2b170] hidden" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14"/>
            </svg>
          </div>
        </label>
      </div>
    ))}

    <!-- Empty Search Results Message -->
    <div id="drawer-no-results" class="hidden text-center py-8 text-stone-400 text-xs font-sans">
      No songs match your search.
    </div>
  </div>

  <!-- Drawer Footer: Minimal Divider + Counter & Help Tooltip -->
  <div class="px-6 py-3 border-t border-white/10 flex items-center justify-between font-sans text-xs text-stone-400/80 tracking-wider">
    <span id="drawer-counter-text">1 / {SONGS.length} songs</span>
    <div class="relative group/box-help flex items-center">
      <button 
        type="button" 
        class="text-[9.5px] text-stone-500 hover:text-[#e2b170] transition-colors cursor-help flex items-center space-x-1 underline decoration-stone-600/40 hover:decoration-[#e2b170]/60 underline-offset-2 focus:outline-none"
        aria-label="What are these boxes for?"
      >
        <span>What are these boxes?</span>
      </button>
      <div class="pointer-events-none absolute bottom-full right-0 mb-2 opacity-0 group-hover/box-help:opacity-100 group-focus-within/box-help:opacity-100 transition-all duration-200 z-50 flex items-center px-2.5 py-1.5 rounded-lg bg-[#0c0e14]/95 backdrop-blur-md border border-white/15 text-[11px] font-sans text-stone-300 shadow-2xl whitespace-nowrap">
        <span>Check a box to exclude that song from playing</span>
      </div>
    </div>
  </div>

  <!-- Standalone Floating Sticky Mini-Player Bar (Distinct floating widget at bottom of drawer) -->
  <div class="p-3 bg-[#06070a]/90 backdrop-blur-xl border-t border-white/10">
    <div 
      id="drawer-mini-player"
      class="w-full bg-[#12151e]/90 hover:bg-[#161a26] border border-[#e2b170]/30 rounded-2xl p-2.5 shadow-2xl flex items-center justify-between transition-all duration-300 group/mini select-none"
    >
      <!-- Left: Equalizer / Pulse & Song Info -->
      <div class="flex items-center space-x-3 min-w-0 flex-1 pr-2">
        <div class="w-8 h-8 rounded-xl bg-[#e2b170]/15 border border-[#e2b170]/30 flex items-center justify-center flex-shrink-0 shadow-inner">
          <div id="mini-player-eq" class="flex items-end space-x-[2px] h-3">
            <span class="w-[2.5px] bg-[#e2b170] rounded-sm eq-bar-1 inline-block"></span>
            <span class="w-[2.5px] bg-[#e2b170] rounded-sm eq-bar-2 inline-block"></span>
            <span class="w-[2.5px] bg-[#e2b170] rounded-sm eq-bar-3 inline-block"></span>
          </div>
        </div>

        <div class="flex-1 min-w-0">
          <p id="mini-player-title" class="font-serif text-sm font-normal text-[#f5f0e1] truncate group-hover/mini:text-[#e2b170] transition-colors leading-tight">
            Iktara
          </p>
          <p id="mini-player-artist" class="font-sans text-[11px] text-stone-400 truncate mt-0.5">
            Amit Trivedi, Kavita Seth
          </p>
        </div>
      </div>

      <!-- Right: Direct Play / Pause Control Button -->
      <button 
        type="button"
        id="btn-mini-play-pause"
        class="w-9 h-9 rounded-full bg-[#e2b170] hover:bg-[#ebd09b] text-[#090b10] flex items-center justify-center flex-shrink-0 transition-all duration-200 shadow-lg hover:scale-105 active:scale-95 cursor-pointer focus:outline-none"
        aria-label="Toggle Play / Pause"
        title="Toggle Playback"
      >
        <svg id="mini-icon-play" class="w-4 h-4 translate-x-[1px]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <svg id="mini-icon-pause" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
        </svg>
      </button>
    </div>
  </div>
</aside>

<!-- Overlay Backdrop: Dims and blurs background photo behind drawer -->
<div 
  id="drawer-backdrop" 
  class="fixed inset-0 bg-black/40 backdrop-blur-xs z-30 opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out cursor-pointer"
></div>

<script>
  import { playSound } from '../lib/sound';

  const drawerSearchInput = document.getElementById('drawer-search-input') as HTMLInputElement | null;
  const drawerSearchClear = document.getElementById('drawer-search-clear') as HTMLButtonElement | null;
  const drawerSongsList = document.getElementById('drawer-songs-list');
  const drawerNoResults = document.getElementById('drawer-no-results');

  function filterDrawerSongs(query: string) {
    const q = query.trim().toLowerCase();
    const items = document.querySelectorAll('.drawer-song-item');
    let visibleCount = 0;

    items.forEach(item => {
      const title = item.getAttribute('data-title') || '';
      const artist = item.getAttribute('data-artist') || '';
      const matches = !q || title.includes(q) || artist.includes(q);
      
      if (matches) {
        (item as HTMLElement).style.display = '';
        visibleCount++;
      } else {
        (item as HTMLElement).style.display = 'none';
      }
    });

    if (drawerNoResults) {
      drawerNoResults.classList.toggle('hidden', visibleCount > 0);
    }

    if (drawerSearchClear) {
      drawerSearchClear.classList.toggle('hidden', q.length === 0);
    }
  }

  if (drawerSearchInput) {
    drawerSearchInput.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      filterDrawerSongs(val);
    });

    drawerSearchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawerSearchInput.value) {
        e.stopPropagation();
        drawerSearchInput.value = '';
        filterDrawerSongs('');
      }
    });
  }

  if (drawerSearchClear) {
    drawerSearchClear.addEventListener('click', () => {
      playSound('select');
      if (drawerSearchInput) {
        drawerSearchInput.value = '';
        drawerSearchInput.focus();
      }
      filterDrawerSongs('');
    });
  }
</script>
