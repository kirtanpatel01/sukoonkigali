---
import { SONGS } from '../data/songs';
---
<aside 
  id="playlist-drawer" 
  class="fixed inset-y-0 right-0 w-full max-w-[340px] bg-[#090b10]/80 backdrop-blur-xs border-l border-white/10 text-stone-200 z-40 transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col shadow-2xl select-none"
  aria-label="Playlist Drawer"
>
  <!-- Drawer Header -->
  <div class="px-6 py-5 border-b border-white/10 flex items-center justify-between">
    <h2 class="font-serif text-xl sm:text-2xl text-[#f5f0e1] font-light tracking-wide">Songs</h2>
    <button 
      id="close-drawer-btn" 
      aria-label="Close Playlist"
      class="text-stone-400 hover:text-[#f5f0e1] transition-colors p-1 cursor-pointer text-lg leading-none"
    >
      ✕
    </button>
  </div>

  <!-- Songs List: Printed / Handwritten aesthetic with tight, restrained spacing -->
  <div id="drawer-songs-list" class="flex-1 overflow-y-auto custom-scrollbar px-6 py-5 space-y-3.5 font-sans">
    {SONGS.map((song, index) => (
      <button 
        data-index={index} 
        class="drawer-song-item w-full text-left transition-all flex items-start space-x-3.5 cursor-pointer group py-0.5 border-b border-transparent"
      >
        <span class="drawer-song-num font-sans text-xs text-stone-500 group-hover:text-[#e2b170] pt-0.5 font-mono min-w-[20px]">
          {(index + 1).toString().padStart(2, '0')}
        </span>
        <div class="flex-1 min-w-0">
          <p class="drawer-song-title font-serif text-[#f5f0e1] group-hover:text-[#e2b170] truncate font-light text-base leading-snug">
            {song.title}
          </p>
          <p class="drawer-song-artist font-sans text-xs text-stone-400/80 truncate mt-0.5">
            {song.artist}
          </p>
        </div>
      </button>
    ))}
  </div>

  <!-- Drawer Footer: Minimal Divider + Counter -->
  <div class="px-6 py-4 border-t border-white/10 text-center font-sans text-xs text-stone-400/80 tracking-wider">
    <span id="drawer-counter-text">1 of {SONGS.length}</span>
  </div>
</aside>

<!-- Overlay Backdrop -->
<div 
  id="drawer-backdrop" 
  class="fixed inset-0 bg-black/35 backdrop-blur-xs z-30 opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out"
></div>

<script is:inline>
  (function() {
    function setupDrawer() {
      const drawer = document.getElementById('playlist-drawer');
      const backdrop = document.getElementById('drawer-backdrop');

      function openDrawer() {
        if (drawer) drawer.classList.remove('translate-x-full');
        if (backdrop) backdrop.classList.remove('opacity-0', 'pointer-events-none');
      }

      function closeDrawer() {
        if (drawer) drawer.classList.add('translate-x-full');
        if (backdrop) backdrop.classList.add('opacity-0', 'pointer-events-none');
      }

      document.addEventListener('click', function(e) {
        const playlistBtn = e.target.closest('#btn-playlist');
        if (playlistBtn) {
          e.preventDefault();
          openDrawer();
          return;
        }
        if (e.target.closest('#close-drawer-btn') || e.target === backdrop) {
          closeDrawer();
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeDrawer();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupDrawer);
    } else {
      setupDrawer();
    }
  })();
</script>
