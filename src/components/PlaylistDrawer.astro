---
import { SONGS } from '../data/songs';
---
<aside 
  id="playlist-drawer" 
  class="fixed inset-y-0 right-0 w-full max-w-[385px] sm:max-w-[420px] bg-[#090b10]/95 backdrop-blur-2xl border-l border-white/10 text-stone-200 z-40 opacity-0 translate-x-5 pointer-events-none transition-all duration-300 ease-in-out flex flex-col shadow-2xl"
  aria-label="Playlist Drawer"
>
  <!-- Drawer Header -->
  <div class="px-6 py-4 border-b border-white/10 flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <h2 class="font-serif text-xl sm:text-2xl text-[#f5f0e1] font-light tracking-wide">Songs</h2>
      <button 
        type="button"
        id="drawer-btn-shuffle" 
        title="Shuffle List"
        aria-label="Toggle Shuffle List"
        class="text-stone-400/80 hover:text-[#e2b170] transition-colors cursor-pointer p-1"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/>
        </svg>
      </button>
    </div>
    <div class="relative group">
      <button 
        type="button"
        id="close-drawer-btn" 
        aria-label="Close Playlist"
        class="text-stone-400 hover:text-[#f5f0e1] transition-colors p-1.5 cursor-pointer text-lg leading-none focus:outline-none"
      >
        ✕
      </button>
      <div class="pointer-events-none absolute -bottom-9 right-0 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-all duration-200 z-30 hidden md:flex items-center space-x-1.5 px-2 py-0.5 rounded-lg bg-[#090b10]/95 backdrop-blur-md border border-white/15 text-[11px] font-sans text-stone-200 shadow-xl whitespace-nowrap">
        <span>Close</span>
        <kbd class="px-1.5 py-0.5 rounded text-[10px] bg-white/10 border border-white/20 font-mono text-[#e2b170] uppercase">Esc</kbd>
      </div>
    </div>
  </div>

  <!-- Search Input inside Drawer -->
  <div class="px-6 py-3 border-b border-white/10 bg-white/[0.02]">
    <div class="relative flex items-center">
      <svg class="w-4 h-4 text-stone-400 absolute left-3.5 pointer-events-none" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
      </svg>
      <input 
        type="text" 
        id="drawer-search-input" 
        placeholder="Search 106 songs or artists..." 
        class="w-full bg-white/5 border border-white/10 rounded-xl pl-10 pr-8 py-2 text-xs sm:text-sm text-[#f5f0e1] placeholder-stone-500/80 focus:outline-none focus:ring-1 focus:ring-[#e2b170]/70 focus:border-[#e2b170]/80 transition-all font-sans" 
      />
      <button 
        type="button"
        id="drawer-search-clear" 
        class="hidden absolute right-3 text-stone-400 hover:text-stone-200 text-xs p-1 cursor-pointer" 
        aria-label="Clear search"
      >
        ✕
      </button>
    </div>
  </div>

  <!-- Songs List: Smooth Touch Scrollable Container -->
  <div 
    id="drawer-songs-list" 
    class="flex-1 overflow-y-auto custom-scrollbar px-6 py-4 space-y-3 font-sans touch-pan-y"
    style="-webkit-overflow-scrolling: touch; touch-action: pan-y;"
  >
    {SONGS.map((song, index) => (
      <div 
        data-index={index} 
        data-youtube-id={song.youtubeId}
        data-title={song.title.toLowerCase()}
        data-artist={song.artist.toLowerCase()}
        class="drawer-song-item w-full text-left transition-all flex items-center justify-between space-x-3 cursor-pointer group py-1.5 border-b border-white/5"
      >
        <div class="flex items-start space-x-3.5 flex-1 min-w-0 drawer-song-click-area">
          <span class="drawer-song-num font-sans text-xs text-stone-500 group-hover:text-[#e2b170] pt-0.5 font-mono min-w-[20px]">
            {(index + 1).toString().padStart(2, '0')}
          </span>
          <div class="flex-1 min-w-0">
            <p class="drawer-song-title font-serif text-[#f5f0e1] group-hover:text-[#e2b170] truncate font-light text-base leading-snug">
              {song.title}
            </p>
            <p class="drawer-song-artist font-sans text-xs text-stone-400/80 truncate mt-0.5">
              {song.artist}
            </p>
          </div>
        </div>
        <label 
          class="exclude-checkbox-label relative flex items-center justify-center p-1.5 cursor-pointer group/checkbox select-none flex-shrink-0" 
          title="Exclude song"
        >
          <input 
            type="checkbox" 
            class="exclude-song-checkbox sr-only" 
            data-youtube-id={song.youtubeId} 
          />
          <div class="checkbox-box w-4 h-4 rounded border border-stone-500/60 group-hover/checkbox:border-[#e2b170] transition-colors flex items-center justify-center bg-black/20">
            <svg class="checkbox-check w-3 h-3 text-[#e2b170] hidden" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
            </svg>
          </div>
        </label>
      </div>
    ))}

    <!-- Empty Search Results Message -->
    <div id="drawer-no-results" class="hidden text-center py-8 text-stone-400 text-xs font-sans">
      No songs match your search.
    </div>
  </div>

  <!-- Drawer Footer: Minimal Divider + Counter -->
  <div class="px-6 py-3 border-t border-white/10 flex items-center justify-between font-sans text-xs text-stone-400/80 tracking-wider">
    <span id="drawer-counter-text">1 of {SONGS.length}</span>
    <span class="text-[11px] text-stone-500 font-mono">{SONGS.length} Songs</span>
  </div>
</aside>

<!-- Overlay Backdrop: Dims and blurs background photo behind drawer -->
<div 
  id="drawer-backdrop" 
  class="fixed inset-0 bg-black/40 backdrop-blur-xs z-30 opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out cursor-pointer"
></div>

<script is:inline>
  (function() {
    function setupDrawer() {
      const drawer = document.getElementById('playlist-drawer');
      const backdrop = document.getElementById('drawer-backdrop');
      const searchInput = document.getElementById('drawer-search-input');
      const searchClear = document.getElementById('drawer-search-clear');
      const songItems = document.querySelectorAll('.drawer-song-item');
      const noResults = document.getElementById('drawer-no-results');

      function openDrawer() {
        if (drawer) {
          drawer.classList.remove('opacity-0', 'translate-x-5', 'pointer-events-none');
          drawer.classList.add('opacity-100', 'translate-x-0', 'pointer-events-auto');
        }
        if (backdrop) {
          backdrop.classList.remove('opacity-0', 'pointer-events-none');
          backdrop.classList.add('opacity-100', 'pointer-events-auto');
        }
      }

      function closeDrawer() {
        if (drawer) {
          drawer.classList.remove('opacity-100', 'translate-x-0', 'pointer-events-auto');
          drawer.classList.add('opacity-0', 'translate-x-5', 'pointer-events-none');
        }
        if (backdrop) {
          backdrop.classList.remove('opacity-100', 'pointer-events-auto');
          backdrop.classList.add('opacity-0', 'pointer-events-none');
        }
      }

      // Real-time Song Search Filtering
      if (searchInput) {
        searchInput.addEventListener('input', function(e) {
          const query = (e.target.value || '').toLowerCase().trim();
          let matchCount = 0;

          if (query.length > 0) {
            if (searchClear) searchClear.classList.remove('hidden');
          } else {
            if (searchClear) searchClear.classList.add('hidden');
          }

          songItems.forEach(item => {
            const title = item.getAttribute('data-title') || '';
            const artist = item.getAttribute('data-artist') || '';
            if (title.includes(query) || artist.includes(query)) {
              item.classList.remove('hidden');
              matchCount++;
            } else {
              item.classList.add('hidden');
            }
          });

          if (noResults) {
            if (matchCount === 0) {
              noResults.classList.remove('hidden');
            } else {
              noResults.classList.add('hidden');
            }
          }
        });
      }

      if (searchClear) {
        searchClear.addEventListener('click', function() {
          if (searchInput) {
            searchInput.value = '';
            searchInput.dispatchEvent(new Event('input'));
          }
        });
      }

      // Close drawer on backdrop click or anywhere outside
      document.addEventListener('click', function(e) {
        const playlistBtn = e.target.closest('#btn-playlist');
        if (playlistBtn) {
          e.preventDefault();
          openDrawer();
          return;
        }

        const isDrawerOpen = drawer && drawer.classList.contains('opacity-100');
        if (!isDrawerOpen) return;

        const closeBtn = e.target.closest('#close-drawer-btn');
        const isOutsideDrawer = !drawer.contains(e.target);

        if (closeBtn || e.target === backdrop || isOutsideDrawer) {
          closeDrawer();
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeDrawer();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupDrawer);
    } else {
      setupDrawer();
    }
  })();
</script>
