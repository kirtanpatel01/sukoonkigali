---
---

<!-- 1. MOBILE LAYOUT: Top-Left (Suggest a Song Button with Profile Bar directly below it) -->
<div class="fixed top-4 left-4 z-20 flex flex-col items-start space-y-2 sm:hidden select-none">
  <!-- Suggest a Song Button -->
  <button 
    class="open-feedback-trigger flex items-center space-x-1.5 font-sans text-xs text-stone-300/80 hover:text-[#e2b170] transition-all p-2 px-3.5 rounded-full bg-black/40 hover:bg-black/60 backdrop-blur-md border border-white/10 shadow-md cursor-pointer focus:outline-none"
    aria-label="Suggest a song"
  >
    <svg class="w-3.5 h-3.5 text-stone-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
    </svg>
    <span class="tracking-wide">Suggest a Song</span>
  </button>

  <!-- Profile Bar (Positioned EXACTLY below Suggest a Song on Mobile with larger icons and spacing) -->
  <div class="flex items-center space-x-3 font-sans text-[11px] text-stone-400/80 bg-black/40 backdrop-blur-md px-3.5 py-2 rounded-full border border-white/10 shadow-md">
    <span class="text-stone-300/90 font-light">Kirtan Patel</span>
    <span class="text-stone-600/80">•</span>
    <div class="flex items-center space-x-3.5">
      <a 
        href="https://youtube.com/playlist?list=PLUKBMAqy5FT0&si=AXqRjl8h_BcCJjnq" 
        target="_blank" 
        rel="noopener noreferrer" 
        title="Sukoon Ki Gali YouTube Playlist"
        aria-label="Sukoon Ki Gali YouTube Playlist"
        class="hover:text-red-400 transition-colors flex items-center p-0.5"
      >
        <svg class="w-4 h-4 text-stone-400 hover:text-red-400 transition-colors" fill="currentColor" viewBox="0 0 24 24">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
      </a>
      <a 
        href="https://github.com/kirtanpatel01/sukoonkigali" 
        target="_blank" 
        rel="noopener noreferrer" 
        title="Sukoon Ki Gali GitHub Repository"
        aria-label="Sukoon Ki Gali GitHub Repository"
        class="hover:text-[#e2b170] transition-colors flex items-center p-0.5"
      >
        <svg class="w-4 h-4 text-stone-400 hover:text-[#e2b170] transition-colors" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>
      <a 
        href="https://instagram.com/kjpatel.dev" 
        target="_blank" 
        rel="noopener noreferrer" 
        title="Instagram Profile"
        aria-label="Instagram Profile"
        class="hover:text-[#e2b170] transition-colors flex items-center p-0.5"
      >
        <svg class="w-4 h-4 text-stone-400 hover:text-[#e2b170] transition-colors" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>
    </div>
  </div>
</div>

<!-- 2. DESKTOP LAYOUT: Bottom-Left (Suggest a Song Button ON TOP of Profile Bar) -->
<div class="fixed bottom-4 left-4 z-20 hidden sm:flex flex-col items-start space-y-2.5 select-none">
  <!-- Suggest a Song Button (Positioned ON TOP of Profile Bar on Desktop) -->
  <div class="relative group">
    <button 
      id="open-feedback-btn" 
      class="open-feedback-trigger flex items-center space-x-1.5 font-sans text-xs text-stone-300/80 hover:text-[#e2b170] transition-all p-2 px-3.5 rounded-full bg-black/40 hover:bg-black/60 backdrop-blur-md border border-white/10 shadow-md cursor-pointer focus:outline-none focus:border-[#e2b170]"
      aria-label="Suggest a song"
    >
      <svg class="w-3.5 h-3.5 text-stone-400 group-hover:text-[#e2b170] transition-colors" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
      </svg>
      <span class="tracking-wide">Suggest a Song</span>
    </button>
    <div class="pointer-events-none absolute -top-9 left-0 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-all duration-200 z-30 hidden md:flex items-center space-x-1.5 px-2.5 py-1 rounded-lg bg-[#090b10]/95 backdrop-blur-md border border-white/15 text-[11px] font-sans text-stone-200 shadow-xl whitespace-nowrap">
      <span>Suggest Song</span>
      <kbd class="px-1.5 py-0.5 rounded text-[10px] bg-white/10 border border-white/20 font-mono text-[#e2b170] uppercase">F</kbd>
    </div>
  </div>

  <!-- Profile Bar (Positioned at the Bottom-Left on Desktop with larger icons and spacing) -->
  <div class="flex items-center space-x-3 font-sans text-xs text-stone-400/80 bg-black/30 hover:bg-black/50 backdrop-blur-md px-4 py-2 rounded-full border border-white/10 shadow-md transition-all">
    <span class="tracking-wide text-stone-300/90 font-light text-[11px] sm:text-xs">Kirtan Patel</span>
    <span class="text-stone-600/80 text-[10px]">•</span>
    <div class="flex items-center space-x-3.5">
      <a 
        href="https://youtube.com/playlist?list=PLUKBMAqy5FT0&si=AXqRjl8h_BcCJjnq" 
        target="_blank" 
        rel="noopener noreferrer"
        title="Sukoon Ki Gali YouTube Playlist"
        aria-label="Sukoon Ki Gali YouTube Playlist"
        class="hover:text-[#e2b170] transition-colors group flex items-center p-0.5"
      >
        <svg class="w-4 h-4 text-stone-400 group-hover:text-red-400 transition-colors" fill="currentColor" viewBox="0 0 24 24">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
      </a>
      <a 
        href="https://github.com/kirtanpatel01/sukoonkigali" 
        target="_blank" 
        rel="noopener noreferrer"
        title="Sukoon Ki Gali GitHub Repository"
        aria-label="Sukoon Ki Gali GitHub Repository"
        class="hover:text-[#e2b170] transition-colors group flex items-center p-0.5"
      >
        <svg class="w-4 h-4 text-stone-400 group-hover:text-[#e2b170] transition-colors" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>
      <a 
        href="https://instagram.com/kjpatel.dev" 
        target="_blank" 
        rel="noopener noreferrer"
        title="Kirtan Patel Instagram Profile"
        aria-label="Kirtan Patel Instagram Profile"
        class="hover:text-[#e2b170] transition-colors group flex items-center p-0.5"
      >
        <svg class="w-4 h-4 text-stone-400 group-hover:text-[#e2b170] transition-colors" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
        </svg>
      </a>
    </div>
  </div>
</div>
