---
const feedbackEndpoint = import.meta.env.PUBLIC_FORMSPREE_FEEDBACK_ENDPOINT || 'https://formspree.io/f/mnpqaboz';
---

<!-- Backdrop Overlay -->
<div 
  id="general-feedback-backdrop" 
  class="fixed inset-0 bg-black/65 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out"
></div>

<!-- Modal Dialog -->
<div 
  id="general-feedback-modal" 
  class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 pointer-events-none opacity-0 transition-all duration-300 ease-in-out"
  role="dialog"
  aria-modal="true"
  aria-labelledby="general-feedback-title"
>
  <div class="w-full max-w-md bg-[#090b10]/95 backdrop-blur-2xl border border-white/15 rounded-2xl shadow-2xl p-6 sm:p-7 text-stone-200 relative max-h-[85vh] sm:max-h-[90vh] overflow-y-auto custom-scrollbar select-none">
    
    <!-- Close Button -->
    <div class="absolute top-5 right-5 group">
      <button 
        type="button"
        id="close-general-feedback-btn" 
        aria-label="Close form"
        class="text-stone-400/70 hover:text-[#f5f0e1] transition-colors p-1 cursor-pointer focus:outline-none"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
      <div class="pointer-events-none absolute -bottom-9 right-0 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-all duration-200 z-30 hidden md:flex items-center space-x-1.5 px-2 py-0.5 rounded-lg bg-[#090b10]/95 backdrop-blur-md border border-white/15 text-[11px] font-sans text-stone-200 shadow-xl whitespace-nowrap">
        <span>Close</span>
        <kbd class="px-1.5 py-0.5 rounded text-[10px] bg-white/10 border border-white/20 font-mono text-[#e2b170] uppercase">Esc</kbd>
      </div>
    </div>

    <!-- Header -->
    <div class="space-y-1 pr-8">
      <h2 id="general-feedback-title" class="font-serif text-2xl sm:text-3xl text-[#f5f0e1] font-light tracking-wide">
        Leave a note
      </h2>
      <p class="font-sans text-xs sm:text-sm text-stone-400/90 font-light leading-relaxed">
        Something you'd like to tell us?
      </p>
    </div>

    <!-- Success View (Hidden by default) -->
    <div id="general-feedback-success-container" class="hidden text-center py-8 space-y-4">
      <div class="w-10 h-10 rounded-full bg-[#e2b170]/15 border border-[#e2b170]/30 text-[#e2b170] flex items-center justify-center mx-auto text-lg">
        ✓
      </div>
      <div class="space-y-1.5">
        <h3 class="font-serif text-2xl text-[#f5f0e1] font-light tracking-wide">
          Thanks for leaving a note.
        </h3>
        <p class="font-sans text-xs sm:text-sm text-stone-400 font-light">
          We appreciate your thoughts.
        </p>
      </div>
      <div class="pt-3">
        <button 
          id="general-feedback-reset-btn" 
          class="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-stone-300 hover:text-[#f5f0e1] font-sans text-xs tracking-wider transition-all cursor-pointer border border-white/10"
        >
          Leave another note
        </button>
      </div>
    </div>

    <!-- Form View -->
    <form id="general-feedback-form" action={feedbackEndpoint} method="POST" class="mt-6 space-y-4 font-sans text-left">
      <!-- Honeypot for spam protection -->
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
      
      <!-- Explicit Form Type for Formspree -->
      <input type="hidden" name="form_type" value="feedback" />

      <!-- 1. Category Selection Pills -->
      <div class="space-y-2">
        <label class="block text-[10px] font-sans font-medium tracking-wider text-stone-400/80 uppercase">
          What would you like to share?
        </label>
        <input type="hidden" name="feedback_type" id="general-feedback-type-hidden" value="Loved it" />
        <div class="flex flex-wrap gap-1.5">
          <button 
            type="button" 
            data-value="Loved it"
            class="general-feedback-type-btn py-1.5 px-3 text-xs font-sans rounded-xl border transition-all cursor-pointer text-center bg-white/10 text-[#f5f0e1] border-white/20 font-medium shadow-xs focus:outline-none"
          >
            Loved it
          </button>
          <button 
            type="button" 
            data-value="Suggest an improvement"
            class="general-feedback-type-btn py-1.5 px-3 text-xs font-sans rounded-xl border transition-all cursor-pointer text-center border-white/5 text-stone-400/80 hover:text-stone-200 hover:border-white/15 bg-transparent focus:outline-none"
          >
            Suggest an improvement
          </button>
          <button 
            type="button" 
            data-value="Something isn't working"
            class="general-feedback-type-btn py-1.5 px-3 text-xs font-sans rounded-xl border transition-all cursor-pointer text-center border-white/5 text-stone-400/80 hover:text-stone-200 hover:border-white/15 bg-transparent focus:outline-none"
          >
            Something isn't working
          </button>
          <button 
            type="button" 
            data-value="Just saying hi"
            class="general-feedback-type-btn py-1.5 px-3 text-xs font-sans rounded-xl border transition-all cursor-pointer text-center border-white/5 text-stone-400/80 hover:text-stone-200 hover:border-white/15 bg-transparent focus:outline-none"
          >
            Just saying hi
          </button>
          <button 
            type="button" 
            data-value="Other"
            class="general-feedback-type-btn py-1.5 px-3 text-xs font-sans rounded-xl border transition-all cursor-pointer text-center border-white/5 text-stone-400/80 hover:text-stone-200 hover:border-white/15 bg-transparent focus:outline-none"
          >
            Other
          </button>
        </div>
      </div>

      <!-- 2. Message / Thoughts (Required Textarea) -->
      <div class="space-y-1.5">
        <label for="general-feedback-message" class="block text-xs font-sans font-medium text-stone-300 tracking-wide">
          Your thoughts <span class="text-[#e2b170]">*</span>
        </label>
        <textarea 
          id="general-feedback-message" 
          name="message" 
          rows="4" 
          maxlength="1500"
          placeholder="Tell us what's on your mind..." 
          class="w-full bg-white/5 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs sm:text-sm text-[#f5f0e1] placeholder-stone-500/80 focus:outline-none focus:ring-1 focus:ring-[#e2b170]/70 focus:border-[#e2b170]/80 transition-all resize-none leading-relaxed font-sans"
        ></textarea>
        <p id="general-error-message" class="hidden text-[11px] text-rose-400/90 pt-0.5">Please share your thoughts before sending.</p>
      </div>

      <!-- 3. Name (Optional) -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label for="general-feedback-name" class="block text-xs font-sans font-medium text-stone-300 tracking-wide">
            Your name
          </label>
          <span class="text-stone-500/80 text-[11px] font-sans">Optional</span>
        </div>
        <input 
          type="text" 
          id="general-feedback-name" 
          name="name" 
          maxlength="100"
          placeholder="Your name" 
          class="w-full bg-white/5 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs sm:text-sm text-[#f5f0e1] placeholder-stone-500/80 focus:outline-none focus:ring-1 focus:ring-[#e2b170]/70 focus:border-[#e2b170]/80 transition-all font-sans"
        />
      </div>

      <!-- Error Alert Banner -->
      <div id="general-feedback-error-banner" class="hidden text-xs text-rose-300 bg-rose-950/40 border border-rose-500/30 rounded-xl p-3 flex items-start space-x-2">
        <svg class="w-4 h-4 text-rose-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>
        </svg>
        <span id="general-error-banner-text">Couldn't send that right now. Please try again.</span>
      </div>

      <!-- Submit Button -->
      <div class="pt-2">
        <button 
          type="submit" 
          id="general-feedback-submit-btn" 
          class="w-full py-3 px-4 rounded-xl bg-[#e2b170] hover:bg-[#ebd09b] text-[#090b10] font-sans font-medium text-xs sm:text-sm tracking-wide transition-all cursor-pointer shadow-lg active:scale-[0.99] flex items-center justify-center space-x-2 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span id="general-submit-btn-text">Send it our way</span>
          <svg id="general-submit-btn-spinner" class="hidden w-4 h-4 animate-spin text-[#090b10]" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
      </div>
    </form>
  </div>
</div>

<script is:inline>
  (function() {
    function setupGeneralFeedbackModal() {
      const modal = document.getElementById('general-feedback-modal');
      const backdrop = document.getElementById('general-feedback-backdrop');
      const closeBtn = document.getElementById('close-general-feedback-btn');
      const form = document.getElementById('general-feedback-form');
      const successContainer = document.getElementById('general-feedback-success-container');
      const resetBtn = document.getElementById('general-feedback-reset-btn');
      
      const hiddenTypeInput = document.getElementById('general-feedback-type-hidden');
      const typeBtns = document.querySelectorAll('.general-feedback-type-btn');
      
      const messageInput = document.getElementById('general-feedback-message');
      const errorMessage = document.getElementById('general-error-message');
      const errorBanner = document.getElementById('general-feedback-error-banner');
      
      const submitBtn = document.getElementById('general-feedback-submit-btn');
      const submitText = document.getElementById('general-submit-btn-text');
      const submitSpinner = document.getElementById('general-submit-btn-spinner');

      let isSubmitting = false;

      function openModal() {
        if (!modal || !backdrop) return;
        backdrop.classList.remove('pointer-events-none', 'opacity-0');
        backdrop.classList.add('opacity-100');

        modal.classList.remove('pointer-events-none', 'opacity-0');
        modal.classList.add('opacity-100');

        setTimeout(() => {
          if (messageInput) messageInput.focus();
        }, 100);
      }

      function closeModal() {
        if (!modal || !backdrop) return;
        backdrop.classList.remove('opacity-100');
        backdrop.classList.add('opacity-0', 'pointer-events-none');

        modal.classList.remove('opacity-100');
        modal.classList.add('opacity-0', 'pointer-events-none');

        setTimeout(resetForm, 350);
      }

      function resetForm() {
        isSubmitting = false;
        if (form) {
          form.reset();
          form.classList.remove('hidden');
        }
        if (successContainer) successContainer.classList.add('hidden');
        if (errorMessage) errorMessage.classList.add('hidden');
        if (errorBanner) errorBanner.classList.add('hidden');
        
        if (submitBtn) submitBtn.disabled = false;
        if (submitText) submitText.innerText = "Send it our way";
        if (submitSpinner) submitSpinner.classList.add('hidden');

        // Reset Pills
        typeBtns.forEach((btn, idx) => {
          if (idx === 0) {
            btn.classList.add('bg-white/10', 'text-[#f5f0e1]', 'border-white/20', 'font-medium');
            btn.classList.remove('bg-transparent', 'text-stone-400/80', 'border-white/5');
            if (hiddenTypeInput) hiddenTypeInput.value = btn.getAttribute('data-value') || 'Loved it';
          } else {
            btn.classList.remove('bg-white/10', 'text-[#f5f0e1]', 'border-white/20', 'font-medium');
            btn.classList.add('bg-transparent', 'text-stone-400/80', 'border-white/5');
          }
        });
      }

      // Pill Category Toggle
      typeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          typeBtns.forEach(b => {
            b.classList.remove('bg-white/10', 'text-[#f5f0e1]', 'border-white/20', 'font-medium');
            b.classList.add('bg-transparent', 'text-stone-400/80', 'border-white/5');
          });
          btn.classList.add('bg-white/10', 'text-[#f5f0e1]', 'border-white/20', 'font-medium');
          btn.classList.remove('bg-transparent', 'text-stone-400/80', 'border-white/5');
          
          const val = btn.getAttribute('data-value') || 'Loved it';
          if (hiddenTypeInput) hiddenTypeInput.value = val;
        });
      });

      // Global click trigger handling for .open-general-feedback-trigger
      document.addEventListener('click', function(e) {
        const trigger = e.target.closest('.open-general-feedback-trigger');
        if (trigger) {
          e.preventDefault();
          openModal();
        }
      });

      if (closeBtn) {
        closeBtn.addEventListener('click', closeModal);
      }

      if (backdrop) {
        backdrop.addEventListener('click', closeModal);
      }

      document.addEventListener('keydown', function(e) {
        const isModalOpen = modal && modal.classList.contains('opacity-100');
        if (isModalOpen && e.key === 'Escape') closeModal();
      });

      if (resetBtn) {
        resetBtn.addEventListener('click', resetForm);
      }

      // Form submission via Vanilla JS Fetch (AJAX) to Formspree
      if (form) {
        form.addEventListener('submit', async function(e) {
          e.preventDefault();
          if (isSubmitting) return;

          if (errorMessage) errorMessage.classList.add('hidden');
          if (errorBanner) errorBanner.classList.add('hidden');

          const messageVal = (messageInput?.value || '').trim();

          if (!messageVal) {
            if (errorMessage) errorMessage.classList.remove('hidden');
            if (messageInput) messageInput.focus();
            return;
          }

          // Set submitting state
          isSubmitting = true;
          if (submitBtn) submitBtn.disabled = true;
          if (submitText) submitText.innerText = "Sending...";
          if (submitSpinner) submitSpinner.classList.remove('hidden');

          const formData = new FormData(form);

          try {
            const response = await fetch(form.action, {
              method: 'POST',
              body: formData,
              headers: {
                'Accept': 'application/json'
              }
            });

            if (response.ok) {
              if (form) form.classList.add('hidden');
              if (successContainer) successContainer.classList.remove('hidden');
            } else {
              const bannerText = document.getElementById('general-error-banner-text');
              if (bannerText) bannerText.innerText = "Couldn't send that right now. Please try again.";
              if (errorBanner) errorBanner.classList.remove('hidden');
              isSubmitting = false;
              if (submitBtn) submitBtn.disabled = false;
              if (submitText) submitText.innerText = "Send it our way";
              if (submitSpinner) submitSpinner.classList.add('hidden');
            }
          } catch (err) {
            const bannerText = document.getElementById('general-error-banner-text');
            if (bannerText) bannerText.innerText = "Couldn't send that right now. Please try again.";
            if (errorBanner) errorBanner.classList.remove('hidden');
            isSubmitting = false;
            if (submitBtn) submitBtn.disabled = false;
            if (submitText) submitText.innerText = "Send it our way";
            if (submitSpinner) submitSpinner.classList.add('hidden');
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupGeneralFeedbackModal);
    } else {
      setupGeneralFeedbackModal();
    }
  })();
</script>
