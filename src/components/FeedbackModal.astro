---
---

<!-- Backdrop Overlay -->
<div 
  id="feedback-backdrop" 
  class="fixed inset-0 bg-black/65 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out"
></div>

<!-- Modal Dialog -->
<div 
  id="feedback-modal" 
  class="fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 pointer-events-none opacity-0 transition-all duration-300 ease-in-out"
  role="dialog"
  aria-modal="true"
  aria-labelledby="feedback-title"
>
  <div class="w-full max-w-md bg-[#090b10]/95 backdrop-blur-2xl border border-white/15 rounded-2xl shadow-2xl p-6 sm:p-7 text-stone-200 relative max-h-[85vh] sm:max-h-[90vh] overflow-y-auto custom-scrollbar select-none">
    
    <!-- Close Button -->
    <div class="absolute top-5 right-5 group">
      <button 
        type="button"
        id="close-feedback-btn" 
        aria-label="Close form"
        class="text-stone-400/70 hover:text-[#f5f0e1] transition-colors p-1 cursor-pointer focus:outline-none"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
      <div class="pointer-events-none absolute -bottom-9 right-0 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-all duration-200 z-30 hidden md:flex items-center space-x-1.5 px-2 py-0.5 rounded-lg bg-[#090b10]/95 backdrop-blur-md border border-white/15 text-[11px] font-sans text-stone-200 shadow-xl whitespace-nowrap">
        <span>Close</span>
        <kbd class="px-1.5 py-0.5 rounded text-[10px] bg-white/10 border border-white/20 font-mono text-[#e2b170] uppercase">Esc</kbd>
      </div>
    </div>

    <!-- Header -->
    <div class="space-y-1 pr-8">
      <h2 id="feedback-title" class="font-serif text-2xl sm:text-3xl text-[#f5f0e1] font-light tracking-wide">
        Help shape Sukoon Ki Gali
      </h2>
      <p class="font-sans text-xs sm:text-sm text-stone-400/90 font-light leading-relaxed">
        Know a song that belongs here — or one that doesn't?
      </p>
    </div>

    <!-- Success View (Hidden by default) -->
    <div id="feedback-success-container" class="hidden text-center py-8 space-y-4">
      <div class="w-10 h-10 rounded-full bg-[#e2b170]/15 border border-[#e2b170]/30 text-[#e2b170] flex items-center justify-center mx-auto text-lg">
        ✓
      </div>
      <div class="space-y-1.5">
        <h3 class="font-serif text-2xl text-[#f5f0e1] font-light tracking-wide">
          Thanks for the suggestion.
        </h3>
        <p class="font-sans text-xs sm:text-sm text-stone-400 font-light">
          We'll take a listen.
        </p>
      </div>
      <div class="pt-3">
        <button 
          id="feedback-reset-btn" 
          class="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-stone-300 hover:text-[#f5f0e1] font-sans text-xs tracking-wider transition-all cursor-pointer border border-white/10"
        >
          Submit another suggestion
        </button>
      </div>
    </div>

    <!-- Form View -->
    <form id="feedback-form" action="https://formspree.io/f/xbgjrgvq" method="POST" class="mt-6 space-y-4 font-sans text-left">
      <!-- Honeypot for spam protection -->
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
      <input type="hidden" name="form_type" value="song_curation" />

      <!-- 1. Feedback Type (Pill / Choice) -->
      <div class="space-y-2">
        <label class="block text-[10px] font-sans font-medium tracking-wider text-stone-400/80 uppercase">
          What would you like to suggest?
        </label>
        <input type="hidden" name="feedback_type" id="feedback-type-hidden" value="Add a song" />
        <div class="grid grid-cols-2 gap-2">
          <button 
            type="button" 
            data-value="Add a song"
            class="feedback-type-btn py-2 px-2 text-xs font-sans rounded-xl border transition-all cursor-pointer text-center bg-white/10 text-[#f5f0e1] border-white/20 font-medium shadow-xs focus:outline-none"
          >
            ＋ Add a song
          </button>
          <button 
            type="button" 
            data-value="Remove a song"
            class="feedback-type-btn py-2 px-2 text-xs font-sans rounded-xl border transition-all cursor-pointer text-center border-white/5 text-stone-400/80 hover:text-stone-200 hover:border-white/15 bg-transparent focus:outline-none"
          >
            − Remove a song
          </button>
        </div>
      </div>

      <!-- 2. Song Title (Required for Add/Remove) -->
      <div id="field-group-song-title" class="space-y-1.5">
        <label for="feedback-song-title" class="block text-xs font-sans font-medium text-stone-300 tracking-wide">
          Song <span id="song-title-required-star" class="text-[#e2b170]">*</span>
        </label>
        <input 
          type="text" 
          id="feedback-song-title" 
          name="song_title" 
          maxlength="200"
          placeholder="Song name" 
          class="w-full bg-white/5 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs sm:text-sm text-[#f5f0e1] placeholder-stone-500/80 focus:outline-none focus:ring-1 focus:ring-[#e2b170]/70 focus:border-[#e2b170]/80 transition-all font-sans"
        />
        <p id="error-song-title" class="hidden text-[11px] text-rose-400/90 pt-0.5">Please enter a song title.</p>
      </div>

      <!-- 3. Artist (Optional) -->
      <div id="field-group-artist" class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label for="feedback-artist" class="block text-xs font-sans font-medium text-stone-300 tracking-wide">
            Artist
          </label>
          <span class="text-stone-500/80 text-[11px] font-sans">Optional</span>
        </div>
        <input 
          type="text" 
          id="feedback-artist" 
          name="artist" 
          maxlength="200"
          placeholder="Artist name" 
          class="w-full bg-white/5 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs sm:text-sm text-[#f5f0e1] placeholder-stone-500/80 focus:outline-none focus:ring-1 focus:ring-[#e2b170]/70 focus:border-[#e2b170]/80 transition-all font-sans"
        />
      </div>

      <!-- 4. Tell us why (Optional Textarea with dynamic placeholder) -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label for="feedback-reason" class="block text-xs font-sans font-medium text-stone-300 tracking-wide">
            Tell us why
          </label>
          <span class="text-stone-500/80 text-[11px] font-sans">Optional</span>
        </div>
        <textarea 
          id="feedback-reason" 
          name="reason" 
          rows="3" 
          maxlength="1000"
          placeholder="What makes it belong here?" 
          class="w-full bg-white/5 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs sm:text-sm text-[#f5f0e1] placeholder-stone-500/80 focus:outline-none focus:ring-1 focus:ring-[#e2b170]/70 focus:border-[#e2b170]/80 transition-all resize-none leading-relaxed font-sans"
        ></textarea>
      </div>

      <!-- Divider for Breathing Room -->
      <div class="pt-2 pb-1 border-t border-white/5"></div>

      <!-- 5. Name (Optional) -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label for="feedback-name" class="block text-xs font-sans font-medium text-stone-300 tracking-wide">
            Your name
          </label>
          <span class="text-stone-500/80 text-[11px] font-sans">Optional</span>
        </div>
        <input 
          type="text" 
          id="feedback-name" 
          name="name" 
          maxlength="100"
          placeholder="Your name" 
          class="w-full bg-white/5 border border-white/10 rounded-xl px-3.5 py-2.5 text-xs sm:text-sm text-[#f5f0e1] placeholder-stone-500/80 focus:outline-none focus:ring-1 focus:ring-[#e2b170]/70 focus:border-[#e2b170]/80 transition-all font-sans"
        />
      </div>

      <!-- General Error Alert Banner -->
      <div id="feedback-error-banner" class="hidden text-xs text-rose-300 bg-rose-950/40 border border-rose-500/30 rounded-xl p-3 flex items-start space-x-2">
        <svg class="w-4 h-4 text-rose-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/>
        </svg>
        <span id="error-banner-text">Could not send submission. Please try again.</span>
      </div>

      <!-- Submit Button -->
      <div class="pt-2">
        <button 
          type="submit" 
          id="feedback-submit-btn" 
          class="w-full py-3 px-4 rounded-xl bg-[#e2b170] hover:bg-[#ebd09b] text-[#090b10] font-sans font-medium text-xs sm:text-sm tracking-wide transition-all cursor-pointer shadow-lg active:scale-[0.99] flex items-center justify-center space-x-2 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span id="submit-btn-text">Send it our way</span>
          <svg id="submit-btn-spinner" class="hidden w-4 h-4 animate-spin text-[#090b10]" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  import { playSound, stopProcessingLoop } from '../lib/sound';
  import { openModalWithBackdrop, closeModalWithBackdrop, bindInputTypingSound, submitFormspreeForm } from '../lib/modalHelper';

  (function() {
    function setupFeedbackModal() {
      const backdrop = document.getElementById('feedback-backdrop');
      const modal = document.getElementById('feedback-modal');
      const form = document.getElementById('feedback-form') as HTMLFormElement | null;
      const successContainer = document.getElementById('feedback-success-container');
      const resetBtn = document.getElementById('feedback-reset-btn');
      const submitBtn = document.getElementById('feedback-submit-btn') as HTMLButtonElement | null;
      const submitText = document.getElementById('submit-btn-text');
      const submitSpinner = document.getElementById('submit-btn-spinner');
      const errorBanner = document.getElementById('feedback-error-banner');
      const errorBannerText = document.getElementById('error-banner-text');
      const songTitleInput = document.getElementById('feedback-song-title') as HTMLInputElement | null;
      const errorSongTitle = document.getElementById('error-song-title');
      const songTitleStar = document.getElementById('song-title-required-star');
      const reasonInput = document.getElementById('feedback-reason') as HTMLTextAreaElement | HTMLInputElement | null;
      const typeBtns = document.querySelectorAll('.feedback-type-btn');
      const hiddenTypeInput = document.getElementById('feedback-type-hidden') as HTMLInputElement | null;

      let isSubmitting = false;

      function openModal() {
        openModalWithBackdrop(modal, backdrop);
      }

      function closeModal() {
        closeModalWithBackdrop(modal, backdrop);
      }

      bindInputTypingSound('#feedback-form');

      function selectFeedbackType(value: string | null) {
        if (hiddenTypeInput) hiddenTypeInput.value = value || '';
        typeBtns.forEach(btn => {
          const val = btn.getAttribute('data-value');
          btn.className = val === value
            ? "feedback-type-btn py-2 px-2 text-xs font-sans rounded-xl border transition-all cursor-pointer text-center bg-white/10 text-[#f5f0e1] border-white/20 font-medium shadow-xs focus:outline-none"
            : "feedback-type-btn py-2 px-2 text-xs font-sans rounded-xl border transition-all cursor-pointer text-center border-white/5 text-stone-400/80 hover:text-stone-200 hover:border-white/15 bg-transparent focus:outline-none";
        });

        if (reasonInput) {
          reasonInput.placeholder = value === 'Remove a song'
            ? "What feels out of place about it?"
            : value === 'Something else'
              ? "Tell us what's on your mind..."
              : "What makes it belong here?";
        }

        if (songTitleStar) songTitleStar.classList.toggle('hidden', value === 'Something else');
        if (errorSongTitle) errorSongTitle.classList.add('hidden');
      }

      typeBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          playSound('select');
          selectFeedbackType(btn.getAttribute('data-value'));
        });
      });

      function resetForm() {
        stopProcessingLoop();
        if (form) form.reset();
        if (successContainer) successContainer.classList.add('hidden');
        if (form) form.classList.remove('hidden');
        if (errorBanner) errorBanner.classList.add('hidden');
        if (errorSongTitle) errorSongTitle.classList.add('hidden');
        if (submitBtn) submitBtn.disabled = false;
        if (submitText) submitText.innerText = "Send it our way";
        if (submitSpinner) submitSpinner.classList.add('hidden');
        isSubmitting = false;
        selectFeedbackType('Add a song');
      }

      document.addEventListener('click', function(e) {
        const target = e.target as HTMLElement | null;
        if (!target) return;
        if (target.closest('#open-feedback-btn') || target.closest('.open-feedback-trigger') || target.closest('#drawer-feedback-btn')) {
          e.preventDefault();
          openModal();
        } else if (target.closest('#close-feedback-btn') || target === backdrop) {
          closeModal();
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeModal();
      });

      if (resetBtn) resetBtn.addEventListener('click', resetForm);

      if (form) {
        form.addEventListener('submit', async function(e) {
          e.preventDefault();
          if (isSubmitting) return;

          if (errorSongTitle) errorSongTitle.classList.add('hidden');
          if (errorBanner) errorBanner.classList.add('hidden');

          const feedbackType = (hiddenTypeInput?.value) || 'Add a song';
          const songTitle = (songTitleInput?.value || '').trim();

          if (feedbackType !== 'Something else' && !songTitle) {
            if (errorSongTitle) errorSongTitle.classList.remove('hidden');
            if (songTitleInput) songTitleInput.focus();
            playSound('error');
            return;
          }

          isSubmitting = true;
          await submitFormspreeForm(
            form,
            { submitBtn, submitText, submitSpinner, errorBanner, errorBannerText, successContainer },
            "Could not send submission. Please try again."
          );
          isSubmitting = false;
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupFeedbackModal);
    } else {
      setupFeedbackModal();
    }
  })();
</script>
