<div class="fixed inset-0 w-screen h-screen z-0 overflow-hidden pointer-events-none select-none">
  <!-- Responsive Full-Screen Background Image -->
  <picture class="w-full h-full min-w-full min-h-full block">
    <source media="(max-width: 639px)" srcset="/bg-mobile.png" />
    <img 
      src="/bg.png" 
      alt="Sukoon Ki Gali" 
      class="w-full h-full object-cover object-center filter brightness-[0.96] contrast-[1.01] min-w-full min-h-full"
    />
  </picture>
  
  <!-- Subtle Bottom Gradient for Text Legibility -->
  <div class="absolute inset-x-0 bottom-0 h-64 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
</div>
